import numpy as np
import matplotlib
matplotlib.use("TkAgg")
import matplotlib.pyplot as plt
import pandas as pd
import os
from scipy.integrate import solve_ivp

# ============================================================
# Refined PEMFC Dynamic Simulation
# Model matches the report / presentation exactly:
#
# State vector (4 states):
#   x[0] = m_H2    [kg]     hydrogen mass in anode compartment
#   x[1] = m_w_an  [kg]     water mass in anode compartment
#   x[2] = m_w_ca  [kg]     water mass in cathode compartment
#   x[3] = zP      [atm·s]  PI integrator for H2 pressure error
#
# Algebraic outputs (NOT states):
#   P_H2      = m_H2 * R_H2 * T / V_an
#   phi_an    = p_v_an / p_sat(T)
#   phi_ca    = p_v_ca / p_sat(T)
#   lambda_m  = ( springer(phi_an) + springer(phi_ca) ) / 2
#
# Water balance (simplified, per report):
#   ṁ_w,an = + W_v,mbr
#   ṁ_w,ca = - W_v,mbr + W_v,gen
#   Sign: W_v,mbr > 0 => net flow from cathode side to anode
#         (back-diffusion dominates electro-osmotic drag)
#
# Voltage (semi-empirical, per cell, using tuned params):
#   v_fc = E - v_act - v_ohm - v_con
# ============================================================

SCRIPT_DIR  = os.path.dirname(os.path.abspath(__file__))
TUNED_CSV   = os.path.normpath(
    os.path.join(SCRIPT_DIR, "..", "..", "tuning parameters", "python", "results", "tuned_params.csv")
)
RESULTS_DIR = os.path.join(SCRIPT_DIR, "results")
os.makedirs(RESULTS_DIR, exist_ok=True)

# ─────────────────────────────────────────────────────────────────────────────
# Physical parameters  (10-cell educational stack, matching tune_cells.py)
# ─────────────────────────────────────────────────────────────────────────────
#
# Inputs:
#   P_H2_ref(t)   [atm]   desired hydrogen pressure
#   I_FC(t)       [A]     stack current
#
# Controller:
#   eP = P_H2_ref - P_H2
#   W_H2_in = W_ff + Kp*eP + Ki*integral(eP)
#
# States:
#   x[0] = m_H2      [kg]   hydrogen mass in anode
#   x[1] = m_w_an    [kg]   water mass in anode control volume
#   x[2] = m_w_ca    [kg]   water mass in cathode control volume
#   x[3] = lambda_m  [-]    membrane water content
#   x[4] = zP        [atm*s] integral of H2-pressure error
#
# Fixed assumptions:
#   P_O2 = constant
#   T    = constant
# ============================================================

# -----------------------------
# Parameters
p = {
    # Universal constants
    "F":       96485.0,     # Faraday constant [C/mol]
    "R_H2":    4124.3,      # H2 specific gas constant [J/(kg·K)]
    "R_v":     461.5,       # water vapour specific gas constant [J/(kg·K)]
    "M_H2":    2.016e-3,    # molar mass H2 [kg/mol]
    "M_H2O":   18.02e-3,    # molar mass water [kg/mol]

    # Stack geometry  (10-cell experimental stack, matching tune_cells.py)
    "n_cells": 10,
    "A_fc":    25e-4,       # active area [m²] = 25 cm²
    "t_m":     178e-6,      # membrane thickness [m]
    "V_an":    1.5e-5,      # anode compartment volume [m³]  (~15 mL)
    "V_ca":    1.5e-5,      # cathode compartment volume [m³] (~15 mL)

    # Nafion membrane material
    "rho_m_dry": 1980.0,    # dry membrane density [kg/m³]
    "M_m_dry":   1.1,       # dry equivalent weight [kg/mol]

    # Fixed operating conditions
    "T":        343.15,     # temperature [K]  (70 °C)
    "P_O2_atm": 0.21,       # O2 partial pressure – open-air cathode [atm]
    "i_max_A":  0.25,       # limiting current [A]  (from tune_cells.py)

    # H2 pressure PI controller with anti-windup
    "Kp_H2":       5e-5,    # proportional gain [kg/(s·atm)]
    "Ki_H2":       1e-5,    # integral gain [kg/(s·atm·s)]
    "W_H2_in_max": 5e-5,    # max inlet flow rate [kg/s]
    "W_H2_in_min": 0.0,
    "K_H2_out":    1e-11,   # passive back-pressure vent [kg/(s·Pa)]
    "P_H2_out_ref_atm": 1.0,

    # Numerical floor
    "eps": 1e-12,
}

# ─────────────────────────────────────────────────────────────────────────────
# Load per-cell tuned parameters from CSV (generated by tune_cells.py)
# ─────────────────────────────────────────────────────────────────────────────
PARAM_NAMES = ["xi1", "xi2", "xi3", "xi4", "B", "c"]
SHARED_CELL = {
    "T_K": p["T"], "P_O2_atm": p["P_O2_atm"],
    "A_fc_m2": p["A_fc"], "t_m_m": p["t_m"], "i_max_A": p["i_max_A"],
}
_DEFAULT = {"xi1": -1.0, "xi2": 3e-3, "xi3": 0.0, "xi4": -1.5e-3, "B": 0.0, "c": 0.0}

try:
    _df_p = pd.read_csv(TUNED_CSV)
    CELL_PARAMS = []
    for _, row in _df_p.iterrows():
        cp = {**SHARED_CELL, **{n: float(row[n]) for n in PARAM_NAMES}}
        CELL_PARAMS.append(cp)
    print(f"Loaded tuned params for {len(CELL_PARAMS)} cells.")
except FileNotFoundError:
    print(f"Warning: tuned_params.csv not found – using default parameters.")
    CELL_PARAMS = [{**SHARED_CELL, **_DEFAULT} for _ in range(10)]


# ─────────────────────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────────────────────

def psat_pa(T):
    """Saturation pressure of water [Pa] – Buck equation."""
    Tc = T - 273.15
    return 611.21 * np.exp((18.678 - Tc / 234.5) * (Tc / (257.14 + Tc)))


def springer(a):
    """Springer sorption isotherm: lambda(a), activity a clamped to [0, 1]."""
    a = np.clip(a, 0.0, 1.0)
    return 0.043 + 17.81 * a - 39.85 * a**2 + 36.0 * a**3


def compute_lambda_m(m_w_an, m_w_ca, T):
    """
    Algebraic membrane water content (report equation):
        lambda_m = ( springer(phi_an) + springer(phi_ca) ) / 2
    Returns (lambda_m, phi_an, phi_ca).
    """
    p_sat  = psat_pa(T)
    p_v_an = max(m_w_an, 0.0) * p["R_v"] * T / p["V_an"]
    p_v_ca = max(m_w_ca, 0.0) * p["R_v"] * T / p["V_ca"]
    phi_an = float(np.clip(p_v_an / p_sat, 0.0, 1.0))
    phi_ca = float(np.clip(p_v_ca / p_sat, 0.0, 1.0))
    lm     = (springer(phi_an) + springer(phi_ca)) / 2.0
    return lm, phi_an, phi_ca


def eod_coeff(lm):
    """Electro-osmotic drag coefficient n_d [-] (Springer model)."""
    lm = max(lm, 0.0)
    return 0.0029 * lm**2 + 0.05 * lm - 3.4e-19


def diffusion_coeff_m2s(lm, T):
    """Water diffusivity in membrane [m²/s] (Springer/Pukrushpan)."""
    lm = float(max(lm, 0.0))
    if lm < 2.0:
        D = 1.0e-6
    elif lm <= 3.0:
        D = 1.0e-6 * (1.0 + 2.0 * (lm - 2.0))
    elif lm < 4.5:
        D = 1.0e-6 * (3.0 - 1.67 * (lm - 3.0))
    else:
        D = 1.25e-6
    return D * np.exp(2416.0 * (1.0 / 303.0 - 1.0 / T)) * 1e-4   # cm²/s → m²/s


def membrane_conc_mol_m3(lm):
    """Water concentration at membrane surface [mol/m³]."""
    return (p["rho_m_dry"] / p["M_m_dry"]) * max(lm, 0.0)


def W_v_mbr_calc(m_w_an, m_w_ca, lm, I, T):
    """
    Net membrane water mass flux [kg/s].
    Sign convention (matches report / presentation):
        W_v,mbr > 0  =>  net flow from cathode side to anode side
                         (back-diffusion dominates osmotic drag)
    Physics:
        N_osm  = n_d * i / F                    [mol/(cm²·s)]  anode→cathode
        N_diff = D_w * (c_ca - c_an) / t_m     [mol/(cm²·s)]  cathode→anode when c_ca > c_an
        N_net  = N_diff - N_osm                 (positive = toward anode)
        W_v,mbr = N_net * M_H2O * A_fc * n_cells
    """
    _, phi_an, phi_ca = compute_lambda_m(m_w_an, m_w_ca, T)
    lam_an = springer(phi_an)
    lam_ca = springer(phi_ca)

    i_density = I / (p["A_fc"] * 1e4)              # [A/cm²]
    nd        = eod_coeff(lm)
    D_cm2s    = diffusion_coeff_m2s(lm, T) * 1e4   # m²/s → cm²/s

    c_an = membrane_conc_mol_m3(lam_an) * 1e-6     # mol/m³ → mol/cm³
    c_ca = membrane_conc_mol_m3(lam_ca) * 1e-6

    t_m_cm = p["t_m"] * 100.0
    A_cm2  = p["A_fc"] * 1e4

    N_osm  = nd * i_density / p["F"]
    N_diff = D_cm2s * (c_ca - c_an) / t_m_cm

    N_net = N_diff - N_osm                          # positive = toward anode
    return N_net * p["M_H2O"] * A_cm2 * p["n_cells"]


def pemfc_voltage(I_A, P_H2_atm, lm, cp):
    """
    Semi-empirical single-cell voltage (report model):
        v_fc = E - v_act - v_ohm - v_con
    cp: dict with xi1..xi4, B, c, T_K, P_O2_atm, A_fc_m2, t_m_m, i_max_A
    """
    T     = cp["T_K"]
    P_O2  = max(cp["P_O2_atm"], 1e-12)
    A     = cp["A_fc_m2"]
    t_m   = cp["t_m_m"]
    i_max = cp["i_max_A"]
    xi1, xi2, xi3, xi4 = cp["xi1"], cp["xi2"], cp["xi3"], cp["xi4"]
    B, c_ohm = cp["B"], cp["c"]

    I_s  = max(float(I_A),      1e-9)
    P_s  = max(float(P_H2_atm), 1e-9)

    E     = 1.229 - 0.85e-3 * (T - 298.15) + 4.3085e-5 * T * (np.log(P_s) + 0.5 * np.log(P_O2))
    C_O2  = P_O2 / (5.1e6 * np.exp(-498.0 / T))
    v_act = xi1 + xi2 * T + xi3 * T * np.log(C_O2) + xi4 * T * np.log(I_s)
    sigma = max((0.5139 * lm - 0.326) * np.exp(1268.0 * (1.0 / 303.15 - 1.0 / T)), 1e-8)
    v_ohm = float(I_A) * (t_m / (A * sigma) + c_ohm)
    v_con = -B * np.log(1.0 - min(float(I_A) / i_max, 0.9999))

    return E - v_act - v_ohm - v_con


def _sat(x, lo, hi):
    return float(np.clip(x, lo, hi))


# ─────────────────────────────────────────────────────────────────────────────
# H2 pressure PI controller with anti-windup
# ─────────────────────────────────────────────────────────────────────────────

def h2_controller(P_ref_atm, P_H2_atm, P_H2_pa, I, zP):
    """
    Returns (W_H2_in, W_H2_out, dzP).
    Feed-forward term = stoichiometric H2 consumption.
    PI feedback corrects pressure error.
    """
    eP      = P_ref_atm - P_H2_atm
    W_ff    = p["M_H2"] * p["n_cells"] * max(I, 0.0) / (2.0 * p["F"])
    W_raw   = W_ff + p["Kp_H2"] * eP + p["Ki_H2"] * zP
    W_in    = _sat(W_raw, p["W_H2_in_min"], p["W_H2_in_max"])
    W_out   = p["K_H2_out"] * max(P_H2_pa - p["P_H2_out_ref_atm"] * 101325.0, 0.0)

    tol = 1e-12
    unsaturated = p["W_H2_in_min"] + tol < W_in < p["W_H2_in_max"] - tol
    aw_lo = W_in <= p["W_H2_in_min"] + tol and eP > 0
    aw_hi = W_in >= p["W_H2_in_max"] - tol and eP < 0
    dzP = eP if (unsaturated or aw_lo or aw_hi) else 0.0

    return W_in, W_out, dzP


# ─────────────────────────────────────────────────────────────────────────────
# ODE right-hand side
# ─────────────────────────────────────────────────────────────────────────────

def rhs(t, x, P_ref_fun, I_FC_fun, I_max):
    """
    dx/dt = f(x, u)
    States : x = [m_H2, m_w_an, m_w_ca, zP]
    Inputs : u = [i_FC, W_H2_in]  (W_H2_in is output of the controller)
    """
    m_H2, m_w_an, m_w_ca, zP = x
    m_H2   = max(m_H2,   p["eps"])
    m_w_an = max(m_w_an, 0.0)
    m_w_ca = max(m_w_ca, 0.0)

    T = p["T"]
    I = float(np.clip(I_FC_fun(t), 0.0, I_max))

    # ── H2 pressure (algebraic) ──────────────────────────────────────────────
    P_H2_pa  = m_H2 * p["R_H2"] * T / p["V_an"]
    P_H2_atm = P_H2_pa / 101325.0
    W_H2_in, W_H2_out, dzP = h2_controller(float(P_ref_fun(t)), P_H2_atm, P_H2_pa, I, zP)
    W_H2_reacted = p["M_H2"] * p["n_cells"] * I / (2.0 * p["F"])

    dm_H2 = W_H2_in - W_H2_out - W_H2_reacted
    if m_H2 <= p["eps"] and dm_H2 < 0:
        dm_H2 = 0.0

    # ── Algebraic lambda_m via Springer isotherm (report equation) ───────────
    lm, _, _ = compute_lambda_m(m_w_an, m_w_ca, T)

    # ── Net membrane water flux (report sign: positive = toward anode) ────────
    W_v_mbr = W_v_mbr_calc(m_w_an, m_w_ca, lm, I, T)

    # ── Water generated at cathode by the electrochemical reaction ────────────
    W_v_gen = p["M_H2O"] * p["n_cells"] * I / (2.0 * p["F"])

    # ── Water balances (report / presentation) ────────────────────────────────
    #   ṁ_w,an = + W_v,mbr
    #   ṁ_w,ca = - W_v,mbr + W_v,gen
    dm_w_an = +W_v_mbr
    dm_w_ca = -W_v_mbr + W_v_gen

    if m_w_an <= 0.0 and dm_w_an < 0:
        dm_w_an = 0.0
    if m_w_ca <= 0.0 and dm_w_ca < 0:
        dm_w_ca = 0.0

    return [dm_H2, dm_w_an, dm_w_ca, dzP]


# ─────────────────────────────────────────────────────────────────────────────
# Post-processing
# ─────────────────────────────────────────────────────────────────────────────

def postprocess(sol, P_ref_fun, I_FC_fun, I_max):
    t      = sol.t
    m_H2   = sol.y[0]
    m_w_an = sol.y[1]
    m_w_ca = sol.y[2]
    T      = p["T"]

    P_H2_pa  = np.maximum(m_H2, p["eps"]) * p["R_H2"] * T / p["V_an"]
    P_H2_atm = P_H2_pa / 101325.0
    I_arr    = np.array([np.clip(I_FC_fun(tt), 0.0, I_max) for tt in t])
    P_ref    = np.array([float(P_ref_fun(tt)) for tt in t])

    lm_arr = np.zeros(len(t))
    phi_an = np.zeros(len(t))
    phi_ca = np.zeros(len(t))
    for k in range(len(t)):
        lm_arr[k], phi_an[k], phi_ca[k] = compute_lambda_m(
            max(m_w_an[k], 0.0), max(m_w_ca[k], 0.0), T
        )

    # Per-cell voltage using tuned semi-empirical parameters
    V_cells = np.zeros((10, len(t)))
    for cell in range(10):
        cp = CELL_PARAMS[cell]
        for i, (I_val, P_val, lm_val) in enumerate(zip(I_arr, P_H2_atm, lm_arr)):
            V_cells[cell, i] = pemfc_voltage(I_val, P_val, lm_val, cp)
    V_stack = V_cells.sum(axis=0)

    return {
        "t": t, "P_H2_ref": P_ref, "P_H2_atm": P_H2_atm,
        "I_FC": I_arr, "phi_an": phi_an, "phi_ca": phi_ca,
        "lambda_m": lm_arr, "V_cells": V_cells, "V_stack": V_stack,
    }


# ─────────────────────────────────────────────────────────────────────────────
# Synthetic experiment profiles
# ─────────────────────────────────────────────────────────────────────────────

def experiment_profiles(exp_id, I_max=0.20):
    if exp_id == 1:
        def P_ref(t): return 1.5
        def I_FC(t):  return I_max * min(t / 100.0, 1.0)
        t_span = (0.0, 120.0)
        title  = "Exp 1: constant $P_{H_2,ref}$, ramping $I_{FC}$"

    elif exp_id == 2:
        def P_ref(t): return 2.0 if t < 40.0 else (3.0 if t < 80.0 else 1.5)
        def I_FC(t):  return I_max * 0.5
        t_span = (0.0, 120.0)
        title  = "Exp 2: stepped $P_{H_2,ref}$, constant $I_{FC}$"

    elif exp_id == 3:
        def P_ref(t):
            if t < 40.0:   return 1.5
            elif t < 80.0: return 2.0
            else:          return 1.0

        def I_FC(t):
            if t < 40.0:   return I_max * 0.25 + I_max * 0.75 * (t / 40.0)
            elif t < 80.0: return I_max - I_max * 0.5 * ((t - 40.0) / 40.0)
            else:          return I_max * 0.5 + I_max * 0.5 * ((t - 80.0) / 40.0)
        t_span = (0.0, 120.0)
        title  = "Exp 3: varying $P_{H_2,ref}$ and $I_{FC}$"

    else:
        raise ValueError("exp_id must be 1, 2, or 3")

    return P_ref, I_FC, t_span, title


# ─────────────────────────────────────────────────────────────────────────────
# Simulation wrapper
# ─────────────────────────────────────────────────────────────────────────────

def simulate(exp_id=1, I_max=0.20):
    P_ref_fun, I_FC_fun, t_span, title = experiment_profiles(exp_id, I_max)
    T  = p["T"]
    P0 = P_ref_fun(0.0)

    m_H2_0   = P0 * 101325.0 * p["V_an"] / (p["R_H2"] * T)
    p_sat0   = psat_pa(T)
    m_w_an_0 = 0.80 * p_sat0 * p["V_an"] / (p["R_v"] * T)   # anode: 80% RH
    m_w_ca_0 = 0.50 * p_sat0 * p["V_ca"] / (p["R_v"] * T)   # cathode: 50% RH
    zP_0     = 0.0

    x0     = [m_H2_0, m_w_an_0, m_w_ca_0, zP_0]
    t_eval = np.linspace(t_span[0], t_span[1], 1000)

    sol = solve_ivp(
        fun=lambda t, x: rhs(t, x, P_ref_fun, I_FC_fun, I_max),
        t_span=t_span, y0=x0, t_eval=t_eval,
        method="RK45", rtol=1e-6, atol=1e-9,
    )
    if not sol.success:
        print(f"  Warning: {sol.message}")

    return postprocess(sol, P_ref_fun, I_FC_fun, I_max), title


# ─────────────────────────────────────────────────────────────────────────────
# Plotting
# ─────────────────────────────────────────────────────────────────────────────

def plot_results(out, title, save_id=None):
    t       = out["t"]
    colours = plt.cm.tab10.colors
    fig, axes = plt.subplots(4, 1, figsize=(12, 14), sharex=True)

    ax = axes[0]
    ax.plot(t, out["P_H2_ref"], lw=2, label=r"$P_{H_2,ref}$ [atm]")
    ax.plot(t, out["P_H2_atm"], "--", lw=2, label=r"$P_{H_2}$ [atm]")
    ax.set_ylabel("Pressure [atm]"); ax.grid(alpha=0.3); ax.legend(loc="upper left")
    ax2 = ax.twinx()
    ax2.plot(t, out["I_FC"], "k:", lw=2, label=r"$I_{FC}$ [A]")
    ax2.set_ylabel("Current [A]"); ax2.legend(loc="upper right")
    ax.set_title(title, fontsize=11)

    ax = axes[1]
    for k in range(10):
        ax.plot(t, out["V_cells"][k] * 1000, color=colours[k], lw=1.5, label=f"Cell {k}")
    ax.set_ylabel("Cell voltage [mV]"); ax.legend(ncol=5, fontsize=7); ax.grid(alpha=0.3)

    ax = axes[2]
    ax.plot(t, out["phi_an"], lw=2, label=r"$\phi_{an}$")
    ax.plot(t, out["phi_ca"], lw=2, label=r"$\phi_{ca}$")
    ax.set_ylabel("Relative humidity [-]"); ax.legend(); ax.grid(alpha=0.3)

    ax = axes[3]
    ax.plot(t, out["lambda_m"], lw=2, color="purple")
    ax.set_ylabel(r"$\lambda_m$ [-]"); ax.set_xlabel("Time [s]"); ax.grid(alpha=0.3)

    plt.tight_layout()
    if save_id is not None:
        path = os.path.join(RESULTS_DIR, f"simulation_exp{save_id}.png")
        plt.savefig(path, dpi=150, bbox_inches="tight")
        print(f"  Saved -> {path}")
    plt.show()


# ─────────────────────────────────────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────────────────────────────────────

if __name__ == "__main__":
    for exp_id in [1, 2, 3]:
        print(f"\nRunning experiment {exp_id} ...")
        out, title = simulate(exp_id, I_max=0.20)
        plot_results(out, title, save_id=exp_id)

