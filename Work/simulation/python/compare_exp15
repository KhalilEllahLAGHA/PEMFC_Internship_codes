import re, os
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from scipy.optimize import minimize_scalar

# ============================================================
# compare_exp15  —  Measured vs Simulated comparison
#
# Feeds the measured inputs (I_FC(t), P_H2(t)) from experiment
# 04_03_2026_15 into the tuned semi-empirical voltage model and
# compares the resulting per-cell voltages with the measurements.
#
# Voltage model (matching finale_one / report):
#   v_fc = E(P_H2, T) - v_act(I, T) - v_ohm(I, lambda_m, T) - v_con(I)
# Parameters: loaded from tuned_params.csv (generated by tune_cells.py)
# lambda_m: held at 14 (consistent with the tuner's SHARED settings)
# ============================================================

SCRIPT_DIR  = os.path.dirname(os.path.abspath(__file__))
LOG_FILE    = os.path.normpath(
    os.path.join(SCRIPT_DIR, "..", "..", "tuning parameters", "python", "experiment_04_03_2026_15.txt")
)
PARAMS_CSV  = os.path.normpath(
    os.path.join(SCRIPT_DIR, "..", "..", "tuning parameters", "python", "results", "tuned_params.csv")
)
RESULTS_DIR = os.path.join(SCRIPT_DIR, "results")
os.makedirs(RESULTS_DIR, exist_ok=True)

R_LOAD = 25.0   # external load resistor [Ohm]

# ─────────────────────────────────────────────────────────────────────────────
# Log parser  (identical to tune_cells.py)
# ─────────────────────────────────────────────────────────────────────────────
_ROW_PAT = re.compile(
    r"Cell0\[V\]:\s*(-?\d+)\s+Cell1\[V\]:\s*(-?\d+)\s+Cell2\[V\]:\s*(-?\d+)\s+"
    r"Cell3\[V\]:\s*(-?\d+)\s+Cell4\[V\]:\s*(-?\d+)\s+Cell5\[V\]:\s*(-?\d+)\s+"
    r"Cell6\[V\]:\s*(-?\d+)\s+Cell7\[V\]:\s*(-?\d+)\s+Cell8\[V\]:\s*(-?\d+)\s+"
    r"Cell9\[V\]:\s*(-?\d+)\s+"
    r"PressureS10\[kPa\]:\s*(-?\d+)\s+PressureS11\[kPa\]:\s*(-?\d+)\s+"
    r"PressureS12\[kPa\]:\s*(-?\d+)\s+"
    r"CurrentS13\[mA\]:\s*(-?\d+)\s+"
    r"MassFlow14\[SCCM\]:\s*(-?\d+)\s+MassFlow15\[SCCM\]:\s*(-?\d+)\s+"
    r"U_Stack\[V\]:\s*(\d+)\s+time\[s\]:\s*(\d+)"
)

def parse_log(filepath):
    rows = []
    with open(filepath, "r", errors="ignore") as fh:
        for line in fh:
            m = _ROW_PAT.search(line)
            if not m:
                continue
            g      = m.groups()
            valve  = int(g[16])
            v_stk  = sum(int(g[k]) for k in range(10)) / 1000.0
            rows.append({
                **{f"Cell{k}_V": int(g[k]) / 1000.0 for k in range(10)},
                "P_H2_atm": (int(g[12]) + 101.325) / 101.325,
                "I_load_A": v_stk / R_LOAD if valve > 0 else 0.0,
                "valve":    valve,
                "time_s":   int(g[17]),
            })
    df = pd.DataFrame(rows).sort_values("time_s").reset_index(drop=True)
    return df


# ─────────────────────────────────────────────────────────────────────────────
# Voltage model  (semi-empirical, report equations)
# ─────────────────────────────────────────────────────────────────────────────
SHARED = {
    "T_K":      343.15,   # 70 °C
    "P_O2_atm": 0.21,
    "lambda_m": 14.0,     # fixed (consistent with tuner)
    "A_fc_m2":  25e-4,
    "t_m_m":    178e-6,
    "i_max_A":  0.25,
}

def pemfc_voltage(I_A, P_H2_atm, cp):
    """
    Vectorised semi-empirical voltage model.
    cp: dict with xi1..xi4, B, c plus SHARED keys.
    Returns cell voltage [V] array same shape as I_A.
    """
    T, P_O2  = cp["T_K"], max(cp["P_O2_atm"], 1e-12)
    A, t_m   = cp["A_fc_m2"], cp["t_m_m"]
    i_max    = cp["i_max_A"]
    lm       = cp["lambda_m"]
    xi1, xi2, xi3, xi4 = cp["xi1"], cp["xi2"], cp["xi3"], cp["xi4"]
    B, c_ohm = cp["B"], cp["c"]

    I_safe   = np.maximum(np.asarray(I_A,      float), 1e-9)
    P_safe   = np.maximum(np.asarray(P_H2_atm, float), 1e-9)
    I_raw    = np.asarray(I_A, float)

    E     = 1.229 - 0.85e-3*(T-298.15) + 4.3085e-5*T*(np.log(P_safe) + 0.5*np.log(P_O2))
    C_O2  = P_O2 / (5.1e6 * np.exp(-498.0 / T))
    v_act = xi1 + xi2*T + xi3*T*np.log(C_O2) + xi4*T*np.log(I_safe)
    sigma = max(float((0.5139*lm - 0.326) * np.exp(1268.0*(1.0/303.15 - 1.0/T))), 1e-8)
    v_ohm = I_raw * (t_m / (A * sigma) + c_ohm)
    v_con = -B * np.log(1.0 - np.clip(I_raw / i_max, 0.0, 0.9999))

    return E - v_act - v_ohm - v_con


# ─────────────────────────────────────────────────────────────────────────────
# OCV (no-load) model – Nernst potential with per-cell effective temperature
# T_eff fitted to the measured open-circuit plateau.  T_eff is an empirical
# scalar absorbing all non-Nernst OCV losses (crossover, degradation, etc.).
# ─────────────────────────────────────────────────────────────────────────────

def nernst_vec(T, P_H2_arr, P_O2=0.21):
    """Nernst open-circuit potential [V], vectorised over P_H2_arr."""
    P_safe = np.maximum(np.asarray(P_H2_arr, float), 1e-9)
    return (1.229 - 0.85e-3 * (T - 298.15)
            + 4.3085e-5 * T * (np.log(P_safe) + 0.5 * np.log(max(P_O2, 1e-12))))


def fit_ocv_temp(V_meas_ocv, P_H2_ocv):
    """
    Find T_eff in [300, 3000] K minimising MSE of
    nernst_vec(T_eff, P_H2_ocv) vs measured OCV.
    """
    def cost(T):
        return np.mean((nernst_vec(T, P_H2_ocv) - V_meas_ocv) ** 2)
    result = minimize_scalar(cost, bounds=(300.0, 3000.0), method="bounded",
                             options={"xatol": 1e-6})
    return float(result.x)


# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

def main():
    # ── Load experimental data ────────────────────────────────────────────────
    print(f"Parsing {LOG_FILE} ...")
    df = parse_log(LOG_FILE)
    print(f"  {len(df)} timesteps loaded  "
          f"(t = {df['time_s'].min()} – {df['time_s'].max()} s)")

    t      = df["time_s"].to_numpy(float)
    I_meas = df["I_load_A"].to_numpy(float)
    P_meas = df["P_H2_atm"].to_numpy(float)

    # ── Load tuned per-cell parameters ───────────────────────────────────────
    print(f"Loading {PARAMS_CSV} ...")
    df_p  = pd.read_csv(PARAMS_CSV)
    PNAMES = ["xi1", "xi2", "xi3", "xi4", "B", "c"]
    cell_params = []
    for _, row in df_p.iterrows():
        cp = {**SHARED, **{n: float(row[n]) for n in PNAMES}}
        cell_params.append(cp)
    print(f"  Loaded {len(cell_params)} cell parameter sets.")

    # ── Static simulation: only on loaded timesteps (I > 1 mA) ──────────────
    # The activation-loss term  xi4*T*log(I)  diverges when I→0,
    # so the model is undefined for zero-current rows.  V_sim is set to NaN
    # for unloaded periods; those samples are excluded from RMSE.
    loaded = I_meas > 0.001

    V_sim  = np.full((10, len(t)), np.nan)
    V_meas = np.zeros((10, len(t)))
    for k in range(10):
        V_sim[k, loaded] = pemfc_voltage(I_meas[loaded], P_meas[loaded], cell_params[k])
        V_meas[k]        = df[f"Cell{k}_V"].to_numpy(float)

    # ── Time-series RMSE (loaded periods only) ────────────────────────────────
    rmse = {}
    for k in range(10):
        err     = V_sim[k][loaded] - V_meas[k][loaded]
        rmse[k] = float(np.sqrt(np.mean(err**2))) * 1000   # [mV]

    print("\nTime-series RMSE (loaded periods only) [mV]:")
    for k in range(10):
        print(f"  Cell{k}: {rmse[k]:.2f} mV")
    print(f"  Mean : {np.mean(list(rmse.values())):.2f} mV")

    # ── OCV model: Nernst with per-cell effective temperature ─────────────────
    ocv_mask = ~loaded
    if ocv_mask.sum() > 0:
        print("\nOCV Nernst fit (T_eff per cell):")
        for k in range(10):
            T_eff_k = fit_ocv_temp(V_meas[k][ocv_mask], P_meas[ocv_mask])
            V_sim[k, ocv_mask] = nernst_vec(T_eff_k, P_meas[ocv_mask])
            rmse_ocv = np.sqrt(np.mean(
                (V_sim[k][ocv_mask] - V_meas[k][ocv_mask]) ** 2)) * 1000
            print(f"  Cell{k}: T_eff = {T_eff_k:.0f} K,  RMSE_OCV = {rmse_ocv:.1f} mV")

    # ── Plot 1: 2×5 grid — per-cell voltage traces ───────────────────────────
    colours = plt.cm.tab10.colors
    fig, axes = plt.subplots(2, 5, figsize=(22, 9), sharex=True)

    for k in range(10):
        ax = axes.flat[k]
        ax.plot(t, V_meas[k] * 1000, color="steelblue", lw=1.0, alpha=0.75, label="Measured")
        ax.plot(t, V_sim[k]  * 1000, color="tomato",    lw=1.5, alpha=0.90, label="Simulated")
        ax.set_title(f"Cell {k}  —  RMSE = {rmse[k]:.1f} mV", fontsize=9)
        ax.set_xlabel("Time [s]", fontsize=8)
        ax.set_ylabel("Voltage [mV]", fontsize=8)
        ax.legend(fontsize=7)
        ax.grid(alpha=0.3)

    plt.suptitle(
        "Experiment 04-03-2026 #15  —  Measured vs Simulated (tuned semi-empirical model)",
        fontsize=12
    )
    plt.tight_layout()
    path1 = os.path.join(RESULTS_DIR, "comparison_exp15_cells.png")
    plt.savefig(path1, dpi=150, bbox_inches="tight")
    print(f"\nSaved -> {path1}")
    plt.close()

    # ── Plot 2: stack voltage + current overview ──────────────────────────────
    V_stk_meas = V_meas.sum(axis=0)
    V_stk_sim  = V_sim.sum(axis=0)

    fig2, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True)

    ax1.plot(t, V_stk_meas, color="steelblue", lw=1.0, alpha=0.8, label="Measured stack")
    ax1.plot(t, V_stk_sim,  color="tomato",    lw=1.5, alpha=0.9, label="Simulated stack")
    ax1.set_ylabel("Stack voltage [V]")
    ax1.legend(); ax1.grid(alpha=0.3)
    ax1.set_title("Stack Voltage: Measured vs Simulated")

    ax2.plot(t, I_meas * 1000, color="darkgreen", lw=1.5)
    ax2.set_ylabel("Load current [mA]")
    ax2.set_xlabel("Time [s]")
    ax2.grid(alpha=0.3)
    ax2.set_title("Measured Load Current")

    plt.tight_layout()
    path2 = os.path.join(RESULTS_DIR, "comparison_exp15_stack.png")
    plt.savefig(path2, dpi=150, bbox_inches="tight")
    print(f"Saved -> {path2}")
    plt.close()

    # ── Plot 3: error bands per cell ──────────────────────────────────────────
    fig3, ax3 = plt.subplots(figsize=(14, 5))
    for k in range(10):
        err_mv = (V_sim[k] - V_meas[k]) * 1000
        ax3.plot(t, err_mv, color=colours[k], lw=1.0, alpha=0.8, label=f"Cell {k}")
    ax3.axhline(0, color="black", lw=0.8, ls="--")
    ax3.set_xlabel("Time [s]")
    ax3.set_ylabel("Error: simulated − measured [mV]")
    ax3.set_title("Per-Cell Voltage Error over Time")
    ax3.legend(ncol=5, fontsize=8)
    ax3.grid(alpha=0.3)
    plt.tight_layout()
    path3 = os.path.join(RESULTS_DIR, "comparison_exp15_error.png")
    plt.savefig(path3, dpi=150, bbox_inches="tight")
    print(f"Saved -> {path3}")
    plt.close()


if __name__ == "__main__":
    main()
