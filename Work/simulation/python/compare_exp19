# ============================================================
# compare_exp19  —  Measured vs Simulated comparison
#
# Experiment 19 has NO valve-driven current control.
# A fixed external resistor (R_LOAD = 25 Ω) is connected at
# the moment the stack voltage drops.
#
# Load detection: first timestep where V_stack stays below
# 60 % of the pre-load OCV for 3 consecutive samples.
#
# Current:  I(t) = V_stack(t) / R_LOAD  (only during loaded window)
#
# Parameters: loaded from tuned_params_exp19.csv
#             (generated by tune_exp19.py)
# ============================================================

SCRIPT_DIR  = os.path.dirname(os.path.abspath(__file__))
LOG_FILE    = os.path.normpath(
    os.path.join(SCRIPT_DIR, "..", "..", "tuning parameters", "python",
                 "experiment_04_03_2026_19.txt")
)
PARAMS_CSV  = os.path.normpath(
    os.path.join(SCRIPT_DIR, "..", "..", "tuning parameters", "python",
                 "results", "tuned_params_exp19.csv")
)
RESULTS_DIR = os.path.join(SCRIPT_DIR, "results")
os.makedirs(RESULTS_DIR, exist_ok=True)

R_LOAD             = 25.0    # external resistor [Ω]
OCV_THRESHOLD_FRAC = 0.60    # load detected when V_stack < 60 % of OCV median

# ─────────────────────────────────────────────────────────────────────────────
# Log parser  (same regex as tune_exp19.py)
# ─────────────────────────────────────────────────────────────────────────────
_ROW_PAT = re.compile(
    r"Cell0\[V\]:\s*(-?\d+)\s+Cell1\[V\]:\s*(-?\d+)\s+Cell2\[V\]:\s*(-?\d+)\s+"
    r"Cell3\[V\]:\s*(-?\d+)\s+Cell4\[V\]:\s*(-?\d+)\s+Cell5\[V\]:\s*(-?\d+)\s+"
    r"Cell6\[V\]:\s*(-?\d+)\s+Cell7\[V\]:\s*(-?\d+)\s+Cell8\[V\]:\s*(-?\d+)\s+"
    r"Cell9\[V\]:\s*(-?\d+)\s+"
    r"PressureS10\[kPa\]:\s*(-?\d+)\s+PressureS11\[kPa\]:\s*(-?\d+)\s+"
    r"PressureS12\[kPa\]:\s*(-?\d+)\s+"
    r"CurrentS13\[mA\]:\s*(-?\d+)\s+"
    r"MassFlow14\[SCCM\]:\s*(-?\d+)\s+MassFlow15\[SCCM\]:\s*(-?\d+)\s+"
    r"U_Stack\[V\]:\s*(\d+)\s+time\[s\]:\s*(\d+)"
)


def parse_log(filepath):
    rows = []
    with open(filepath, "r", errors="ignore") as fh:
        for line in fh:
            m = _ROW_PAT.search(line)
            if not m:
                continue
            g     = m.groups()
            cells = [int(g[k]) / 1000.0 for k in range(10)]
            rows.append({
                **{f"Cell{k}_V": cells[k] for k in range(10)},
                "V_stk"    : sum(cells),
                "P_H2_atm" : (int(g[12]) + 101.325) / 101.325,
                "time_s"   : int(g[17]),
            })

    df = pd.DataFrame(rows).sort_values("time_s").reset_index(drop=True)

    # ── Detect load start ─────────────────────────────────────────────────────
    ocv_baseline = df["V_stk"].iloc[:50].median()
    threshold    = OCV_THRESHOLD_FRAC * ocv_baseline
    vstk = df["V_stk"].to_numpy()
    t_load_idx = None
    for i in range(len(vstk) - 2):
        if vstk[i] < threshold and vstk[i+1] < threshold and vstk[i+2] < threshold:
            t_load_idx = i
            break

    if t_load_idx is None:
        raise RuntimeError("Could not find sustained voltage drop. Check log file.")

    t_load_start = int(df["time_s"].iloc[t_load_idx])

    # ── Detect load end: largest positive voltage jump after load start ───────
    # The resistor removal produces the sharpest single-step voltage rise in the
    # entire post-load-start window.  That step index is the exact change point.
    search_vstk = vstk[t_load_idx:]
    dv           = np.diff(search_vstk)
    jump_rel     = int(np.argmax(dv))           # index of the largest positive jump
    t_load_end_idx = t_load_idx + jump_rel + 1  # first sample AFTER the jump

    t_load_end = int(df["time_s"].iloc[t_load_end_idx])

    print(f"OCV baseline : {ocv_baseline*1000:.0f} mV")
    print(f"Threshold    : {threshold*1000:.0f} mV")
    print(f"Load detected: t = {t_load_start} s")
    print(f"Load removed : t = {t_load_end} s")

    loaded         = (df["time_s"] >= t_load_start) & (df["time_s"] < t_load_end)
    df["loaded"]   = loaded
    df["I_load_A"] = np.where(loaded, df["V_stk"] / R_LOAD, 0.0)

    return df, t_load_start, t_load_end, ocv_baseline


# ─────────────────────────────────────────────────────────────────────────────
# Voltage model  (semi-empirical — identical to tune_exp19.py)
# ─────────────────────────────────────────────────────────────────────────────
SHARED = {
    "T_K":      343.15,
    "P_O2_atm": 0.21,
    "lambda_m": 14.0,
    "A_fc_m2":  25e-4,
    "t_m_m":    178e-6,
    "i_max_A":  0.25,
}
PARAM_NAMES = ["xi1", "xi2", "xi3", "xi4", "B", "c"]


def pemfc_voltage(I_A, P_H2_atm, cp):
    """
    Vectorised semi-empirical cell voltage model.
    Only call with I_A > 0; the activation term log(I) diverges at I=0.
    """
    T, P_O2  = cp["T_K"], max(cp["P_O2_atm"], 1e-12)
    A, t_m   = cp["A_fc_m2"], cp["t_m_m"]
    i_max    = cp["i_max_A"]
    lm       = cp["lambda_m"]
    xi1, xi2, xi3, xi4 = cp["xi1"], cp["xi2"], cp["xi3"], cp["xi4"]
    B, c_ohm = cp["B"], cp["c"]

    I_safe = np.maximum(np.asarray(I_A,      float), 1e-6)
    P_safe = np.maximum(np.asarray(P_H2_atm, float), 1e-9)
    I_raw  = np.asarray(I_A, float)

    E     = 1.229 - 0.85e-3*(T-298.15) + 4.3085e-5*T*(np.log(P_safe) + 0.5*np.log(P_O2))
    C_O2  = P_O2 / (5.1e6 * np.exp(-498.0 / T))
    v_act = xi1 + xi2*T + xi3*T*np.log(C_O2) + xi4*T*np.log(I_safe)
    sigma = max(float((0.5139*lm - 0.326) * np.exp(1268.0*(1/303.15 - 1/T))), 1e-8)
    v_ohm = I_raw * (t_m / (A * sigma) + c_ohm)
    v_con = -B * np.log(1.0 - np.clip(I_raw / i_max, 0.0, 0.999999))

    return E - v_act - v_ohm - v_con


# ─────────────────────────────────────────────────────────────────────────────
# OCV (no-load) model – Nernst potential with per-cell effective temperature
# T_eff fitted to the measured open-circuit plateau.  T_eff is an empirical
# scalar absorbing all non-Nernst OCV losses (crossover, degradation, etc.).
# ─────────────────────────────────────────────────────────────────────────────

def nernst_vec(T, P_H2_arr, P_O2=0.21):
    """Nernst open-circuit potential [V], vectorised over P_H2_arr."""
    P_safe = np.maximum(np.asarray(P_H2_arr, float), 1e-9)
    return (1.229 - 0.85e-3 * (T - 298.15)
            + 4.3085e-5 * T * (np.log(P_safe) + 0.5 * np.log(max(P_O2, 1e-12))))


def fit_ocv_temp(V_meas_ocv, P_H2_ocv):
    """
    Find T_eff in [300, 3000] K minimising MSE of
    nernst_vec(T_eff, P_H2_ocv) vs measured OCV.
    """
    def cost(T):
        return np.mean((nernst_vec(T, P_H2_ocv) - V_meas_ocv) ** 2)
    result = minimize_scalar(cost, bounds=(300.0, 3000.0), method="bounded",
                             options={"xatol": 1e-6})
    return float(result.x)


# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

def main():
    # ── Parse log ─────────────────────────────────────────────────────────────
    print(f"Parsing {LOG_FILE} ...")
    df, t_load_start, t_load_end, ocv_baseline = parse_log(LOG_FILE)
    print(f"  {len(df)} timesteps  "
          f"(t = {df['time_s'].min()} – {df['time_s'].max()} s)\n")

    t      = df["time_s"].to_numpy(float)
    I_meas = df["I_load_A"].to_numpy(float)
    P_meas = df["P_H2_atm"].to_numpy(float)
    loaded = df["loaded"].to_numpy(bool)

    # ── Load tuned parameters ─────────────────────────────────────────────────
    print(f"Loading {PARAMS_CSV} ...")
    df_p = pd.read_csv(PARAMS_CSV)
    cell_params = []
    for _, row in df_p.iterrows():
        cell_params.append({**SHARED, **{n: float(row[n]) for n in PARAM_NAMES}})
    print(f"  {len(cell_params)} cell parameter sets loaded.\n")

    # ── Simulate: model only valid where I > 0 ────────────────────────────────
    # V_sim is NaN for unloaded timesteps so the activation term log(I)
    # does not blow up and the plots show a clean gap at OCV.
    V_sim  = np.full((10, len(t)), np.nan)
    V_meas = np.zeros((10, len(t)))
    for k in range(10):
        V_sim[k, loaded] = pemfc_voltage(I_meas[loaded], P_meas[loaded], cell_params[k])
        V_meas[k]        = df[f"Cell{k}_V"].to_numpy(float)

    # ── RMSE over loaded period ────────────────────────────────────────────────
    rmse = {}
    for k in range(10):
        err     = V_sim[k][loaded] - V_meas[k][loaded]
        rmse[k] = float(np.sqrt(np.mean(err**2))) * 1000   # [mV]

    print("Time-series RMSE (loaded window) [mV]:")
    for k in range(10):
        flag = "  *** near-zero OCV" if V_meas[k][loaded].mean() < 0.050 else ""
        print(f"  Cell{k}: {rmse[k]:.2f} mV{flag}")
    print(f"  Mean : {np.mean(list(rmse.values())):.2f} mV\n")

    # ── OCV model: Nernst with per-cell effective temperature ─────────────────
    ocv_mask = ~loaded
    if ocv_mask.sum() > 0:
        print("OCV Nernst fit (T_eff per cell):")
        for k in range(10):
            T_eff_k = fit_ocv_temp(V_meas[k][ocv_mask], P_meas[ocv_mask])
            V_sim[k, ocv_mask] = nernst_vec(T_eff_k, P_meas[ocv_mask])
            rmse_ocv = np.sqrt(np.mean(
                (V_sim[k][ocv_mask] - V_meas[k][ocv_mask]) ** 2)) * 1000
            print(f"  Cell{k}: T_eff = {T_eff_k:.0f} K,  RMSE_OCV = {rmse_ocv:.1f} mV")
        print()

    colours = plt.cm.tab10.colors

    # ── Plot 1: 2×5 per-cell traces ───────────────────────────────────────────
    fig, axes = plt.subplots(2, 5, figsize=(20, 8), sharex=True)
    for k in range(10):
        ax = axes.flat[k]
        degraded = V_meas[k][loaded].mean() < 0.010
        ax.plot(t, V_meas[k] * 1000, color="steelblue",
                lw=1.6, alpha=0.85, label="Measured")
        ax.plot(t, V_sim[k]  * 1000, color="tomato",
                lw=1.8, alpha=0.95, label="Simulated")
        ax.axvline(t_load_start, color="gray", lw=1.0, ls="--", alpha=0.6)
        if t_load_end is not None:
            ax.axvline(t_load_end, color="darkorange", lw=1.0, ls="--", alpha=0.6)
        tag = "  (degraded)" if degraded else ""
        ax.set_title(f"Cell {k} — RMSE {rmse[k]:.1f} mV{tag}",
                     color=("crimson" if degraded else "black"))
        if k >= 5:
            ax.set_xlabel("Time [s]")
        if k % 5 == 0:
            ax.set_ylabel("Cell voltage [mV]")
        ax.legend(loc="lower right")

    plt.suptitle(
        "Optimization Experiment — measured vs. simulated per-cell voltage "
        f"(load on at t = {t_load_start} s, off at t = {t_load_end} s)",
        fontsize=14, fontweight="bold")
    plt.tight_layout()
    path1 = os.path.join(RESULTS_DIR, "comparison_exp19_cells.png")
    plt.savefig(path1, bbox_inches="tight")
    print(f"Saved -> {path1}")
    plt.close()

    # ── Plot 2: stack voltage + current overview ──────────────────────────────
    V_stk_meas = V_meas.sum(axis=0)
    V_stk_sim  = V_sim.sum(axis=0)

    fig2, axes2 = plt.subplots(2, 1, figsize=(12, 7), sharex=True)

    ax = axes2[0]
    ax.plot(t, V_stk_meas * 1000, color="steelblue", lw=2.0, label="Measured")
    ax.plot(t, V_stk_sim  * 1000, color="tomato",    lw=2.0, label="Simulated")
    ax.axvline(t_load_start, color="gray", lw=1.0, ls="--",
               label=f"Load on (t = {t_load_start} s)")
    if t_load_end is not None:
        ax.axvline(t_load_end, color="darkorange", lw=1.0, ls="--",
                   label=f"Load off (t = {t_load_end} s)")
    ax.axhline(ocv_baseline * 1000, color="gray", lw=1.0, ls=":",
               label=f"OCV = {ocv_baseline*1000:.0f} mV")
    ax.set_ylabel("Stack voltage [mV]")
    ax.legend(loc="center right", ncol=1, framealpha=0.9)
    ax.set_title("Stack voltage: measured vs. simulated", fontweight="bold")

    ax = axes2[1]
    ax.plot(t, I_meas * 1000, color="darkgreen", lw=2.0)
    ax.axvline(t_load_start, color="gray", lw=1.0, ls="--")
    if t_load_end is not None:
        ax.axvline(t_load_end, color="darkorange", lw=1.0, ls="--")
    ax.set_ylabel("Load current [mA]")
    ax.set_xlabel("Time [s]")
    ax.set_title("Load current (I = V$_{stack}$ / 25 Ω)", fontweight="bold")

    plt.tight_layout()
    path2 = os.path.join(RESULTS_DIR, "comparison_exp19_stack.png")
    plt.savefig(path2, bbox_inches="tight")
    print(f"Saved -> {path2}")
    plt.close()

    # ── Plot 3: per-cell error (loaded window only) ────────────────────────────
    fig3, ax3 = plt.subplots(figsize=(12, 5))
    for k in range(10):
        if V_meas[k][loaded].mean() < 0.010:   # skip degraded cells (flat ~0 V)
            continue
        err_mv = (V_sim[k] - V_meas[k]) * 1000   # NaN for unloaded
        ax3.plot(t, err_mv, color=colours[k], lw=1.4, alpha=0.85, label=f"Cell {k}")
    ax3.axhline(0, color="black", lw=1.0, ls="--")
    ax3.axvline(t_load_start, color="gray", lw=1.0, ls="--", alpha=0.6)
    if t_load_end is not None:
        ax3.axvline(t_load_end, color="darkorange", lw=1.0, ls="--", alpha=0.6)
    ax3.set_xlabel("Time [s]")
    ax3.set_ylabel("Voltage error: simulated − measured [mV]")
    ax3.set_title("Per-cell voltage residual over the loaded window (healthy cells)",
                  fontweight="bold")
    ax3.legend(ncol=4, loc="upper right", framealpha=0.9)
    plt.tight_layout()
    path3 = os.path.join(RESULTS_DIR, "comparison_exp19_error.png")
    plt.savefig(path3, bbox_inches="tight")
    print(f"Saved -> {path3}")
    plt.close()


if __name__ == "__main__":
    main()
